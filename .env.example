LLM_PROVIDER=ollama
LLM_MODEL=mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
GITHUB_TOKEN=
GITHUB_REPO=scha-chan/radar-impact-agent
CONFIDENCE_THRESHOLD=70
APPROVAL_TTL_HOURS=24
TOOL_TIMEOUT_SECONDS=10
MAX_RETRIES=2
DRY_RUN=false
CHROMA_PERSIST_DIR=chroma
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.3
CHECKPOINT_DB_PATH=radar_checkpoints.db
AUDIT_LOG_PATH=audit/trail.jsonl
# Orçamento de execução (RF-06.5, card 35) e versionamento (RF-09.5)
MAX_STEPS=12
MAX_WALL_TIME_SECONDS=60
AGENT_VERSION=0.1.0
PROMPT_VERSION=1
POLICY_VERSION=1
# Tracing OpenTelemetry (RF-09.2/09.6, card 35) - console desligado por padrão
OTEL_CONSOLE_EXPORT=false
# Automação low-code (card 29) - workflow n8n, docs/lowcode/workflow-n8n.json
RADAR_API_URL=http://localhost:8000
RADAR_APPROVAL_URL=http://localhost:8000
DISCORD_WEBHOOK_URL=
